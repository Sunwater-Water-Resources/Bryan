Juniper Creek Dam - SYNTHETIC STUB, not a working URBS model
C It will not run in URBS. Replace with a calibrated vec file for a real study.
C The structure is real: areas come from the catchment data file, the routing
C is a SPLIT model, and the dam uses the level-based DAM ROUTE form Bryan
C detects from FSL= (rather than the volume-based VBF= form).
MODEL: SPLIT
USES: L, I
DEFAULT PARAMETERS: alpha = 0.30 m = 0.80 beta = 1.50 n = 0.80 x = 0
CATCHMENT DATA FILE = juniper.dat

C ---- western headwater ----
RAIN #1 L = 5.10 Sc = 0.0180
STORE.
	RAIN #2 L = 4.35 Sc = 0.0210
	GET.
ROUTE THRU #3 L = 6.20 Sc = 0.0120
ADD RAIN #3 L = 6.20 Sc = 0.0120
PRINT.JC_WEST

C ---- eastern headwater ----
STORE.
	RAIN #4 L = 4.80 Sc = 0.0195
	ROUTE THRU #5 L = 5.55 Sc = 0.0145
	ADD RAIN #5 L = 5.55 Sc = 0.0145
	PRINT.JC_EAST
	GET.

C ---- main stem to the dam ----
ROUTE THRU #6 L = 5.00 Sc = 0.0100
ADD RAIN #6 L = 5.00 Sc = 0.0100
ROUTE THRU #7 L = 5.00 Sc = 0.0100
ADD RAIN #7 L = 5.00 Sc = 0.0100
ROUTE THRU #8 L = 5.00 Sc = 0.0100
ADD RAIN #8 L = 5.00 Sc = 0.0100
ROUTE THRU #9 L = 5.00 Sc = 0.0100
ADD RAIN #9 L = 5.00 Sc = 0.0100
ROUTE THRU #10 L = 5.00 Sc = 0.0100
ADD RAIN #10 L = 5.00 Sc = 0.0100
PRINT.JC_INFLOW

DAM ROUTE FSL=210.0 datafile=SYNTHETIC_juniper.els il=initial_lake_level location=JUNIPER FILE=SYNTHETIC_juniper.sq
PRINT.JC_OUTFLOW
END OF CATCHMENT DATA.
