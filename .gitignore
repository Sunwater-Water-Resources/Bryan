# ---------------------------
# Python virtual environments
# ---------------------------
env/
venv/
.venv/

# ---------------------------
# Python cache and artifacts
# ---------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.py[cod]

# ---------------------------
# Distribution / packaging
# ---------------------------
build/
dist/
*.egg-info/

# ---------------------------
# Logs and temp files
# ---------------------------
*.log
*.tmp
*.bak

# ---------------------------
# IDE / editor settings
# ---------------------------
.vscode/
.idea/

# ---------------------------
# OS files
# ---------------------------
.DS_Store
Thumbs.db

# ---------------------------
# SVN metadata (important)
# ---------------------------
.svn/

# ---------------------------
# Data files (adjust as needed)
# ---------------------------
# Large hydrology datasets / model inputs/outputs
*.csv
*.xlsx
*.xls
*.nc
*.grib
*.tif
*.img

# If you DO want to keep certain data, comment out above and whitelist specific folders:
# !data/
# !inputs/

# ---------------------------
# Model outputs / results
# ---------------------------
outputs/
results/
figures/
plots/

# ---------------------------
# Environment / config secrets
# ---------------------------
.env
*.env

# ---------------------------
# Local reference material (manuals, example files)
# ---------------------------
References/

# ---------------------------
# Generated manual output (from Manual/render_manual.py)
# ---------------------------
*.md.html
Manual/markdeep.min.js
# ---------------------------
# The example project ships its own (synthetic) data - see example_project/README.md
# The blanket *.csv / *.xlsx rules above would otherwise drop most of it.
# Its results/ folder stays ignored, being run output.
# ---------------------------
!example_project/**/*.csv
!example_project/**/*.xlsx
example_project/model/*/storms/
example_project/SimsList_*_log.csv

# ---------------------------
# Run launcher UI (ui/)
# ---------------------------
# Run folders the UI writes into a project. They live beside the model data,
# not in here, but ignore the name in case anyone runs the UI from the repo.
_ui_runs/

# The UI's only real-Bryan test fixture. The *.csv and *.xlsx rules above
# would otherwise delete it silently from a fresh clone, and with it the one
# test that drives Bryan itself end to end.
!ui/tests/data_rr/**
